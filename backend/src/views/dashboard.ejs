<div class="page-header">
  <div>
    <h2>Dashboard</h2>
    <p>Visão geral dos indicadores de qualidade</p>
  </div>
  <div class="flex items-center gap-3">
    <select class="form-select" style="width:auto" id="dash-ano"
            hx-get="/dashboard/semaforo"
            hx-target="#semaforo-container"
            hx-include="#dash-mes"
            name="ano">
      <% for (let y = new Date().getFullYear(); y >= 2024; y--) { %>
        <option value="<%= y %>" <%= y === ano ? 'selected' : '' %>><%= y %></option>
      <% } %>
    </select>
    <select class="form-select" style="width:auto" id="dash-mes"
            hx-get="/dashboard/semaforo"
            hx-target="#semaforo-container"
            hx-include="#dash-ano"
            name="mes">
      <% const nomesMes = ['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez']; %>
      <% for (let m = 1; m <= 12; m++) { %>
        <option value="<%= m %>" <%= m === mes ? 'selected' : '' %>><%= nomesMes[m] %></option>
      <% } %>
    </select>
    <span class="htmx-indicator"><span class="spinner"></span></span>
  </div>
</div>

<div id="semaforo-container">
  <%- include('../components/semaforo-grid', { indicadores }) %>
</div>
