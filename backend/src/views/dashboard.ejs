<%
const mesesLabels = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const pacientesTotal = Number(registro?.pacientes_total ?? 0);
const pacientesAD = Number(registro?.pacientes_ad ?? 0);
const pacientesID = Number(registro?.pacientes_id ?? 0);
const eventosAdversos = Number(registro?.eventos_adversos_total ?? 0);
const taxaAltas = Number(registro?.taxa_altas_pct ?? 0);
%>

<div class="page-header">
  <div class="flex items-center gap-3">
    <div style="width:2.5rem;height:2.5rem;border-radius:var(--radius-md);background:rgba(59,130,246,.15);color:#60a5fa;display:flex;align-items:center;justify-content:center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    </div>
    <div>
      <h2>Dashboard</h2>
      <p>Visão consolidada dos indicadores assistenciais</p>
    </div>
  </div>
</div>

<!-- Período + Exportação -->
<div class="glass-card no-hover" style="padding:.75rem 1rem;position:relative;z-index:10">
  <div class="flex items-center gap-3" style="flex-wrap:wrap">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <span style="font-size:.75rem;font-weight:600;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.05em">Período</span>
    <select class="form-select" style="width:auto" id="dash-mes" onchange="updateDashboard()">
      <% mesesLabels.forEach(function(m, i) { %>
        <option value="<%= i+1 %>" <%= (i+1) === mes ? 'selected' : '' %>><%= m %></option>
      <% }) %>
    </select>
    <select class="form-select" style="width:auto" id="dash-ano" onchange="updateDashboard()">
      <% [2025,2026,2027].forEach(function(y) { %>
        <option value="<%= y %>" <%= y === ano ? 'selected' : '' %>><%= y %></option>
      <% }) %>
    </select>
    <div style="width:1px;height:1.25rem;background:var(--color-border);margin:0 .25rem"></div>
    <a href="/api/v1/relatorio/excel/<%= ano %>/<%= mes %>" target="_blank" class="btn btn-sm" style="background:#059669;color:white">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Excel
    </a>
    <a href="/api/v1/relatorio/pdf/<%= ano %>/<%= mes %>" target="_blank" class="btn btn-primary btn-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      PDF
    </a>
  </div>
</div>

<!-- Resumo Cards -->
<div class="grid grid-3 gap-4">
  <div class="glass-card no-hover" style="padding:1.25rem">
    <div class="flex items-center gap-3" style="margin-bottom:.75rem">
      <div style="width:2.5rem;height:2.5rem;border-radius:var(--radius-md);background:rgba(59,130,246,.15);color:#60a5fa;display:flex;align-items:center;justify-content:center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      </div>
      <div>
        <p style="font-size:.75rem;color:var(--color-text-muted);font-weight:500">Pacientes Ativos</p>
        <p style="font-size:1.5rem;font-weight:700;color:var(--color-text-primary);font-variant-numeric:tabular-nums"><%= pacientesTotal %></p>
      </div>
    </div>
    <p style="font-size:.6875rem;color:var(--color-text-muted)"><%= pacientesAD %> AD · <%= pacientesID %> ID</p>
  </div>

  <div class="glass-card no-hover" style="padding:1.25rem">
    <div class="flex items-center gap-3" style="margin-bottom:.75rem">
      <div style="width:2.5rem;height:2.5rem;border-radius:var(--radius-md);background:rgba(239,68,68,.15);color:#f87171;display:flex;align-items:center;justify-content:center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <p style="font-size:.75rem;color:var(--color-text-muted);font-weight:500">Eventos Adversos</p>
        <p style="font-size:1.5rem;font-weight:700;color:var(--color-text-primary);font-variant-numeric:tabular-nums"><%= eventosAdversos %></p>
      </div>
    </div>
    <p style="font-size:.6875rem;color:var(--color-text-muted)">Quedas, broncoasp., lesão pressão, decanulação, saída GTT</p>
  </div>

  <div class="glass-card no-hover" style="padding:1.25rem">
    <div class="flex items-center gap-3" style="margin-bottom:.75rem">
      <div style="width:2.5rem;height:2.5rem;border-radius:var(--radius-md);background:rgba(16,185,129,.15);color:#34d399;display:flex;align-items:center;justify-content:center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <div>
        <p style="font-size:.75rem;color:var(--color-text-muted);font-weight:500">Taxa de Altas</p>
        <p style="font-size:1.5rem;font-weight:700;color:var(--color-text-primary);font-variant-numeric:tabular-nums"><%= taxaAltas %>%</p>
      </div>
    </div>
    <p style="font-size:.6875rem;color:var(--color-text-muted)">Percentual de altas domiciliares no período</p>
  </div>
</div>

<!-- Semáforo Grid -->
<div>
  <h3 style="font-size:.875rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:1rem">Indicadores — Semáforos</h3>
  <div id="semaforo-grid">
    <%- include('./components/semaforo-grid', { indicadores }) %>
  </div>
</div>

<!-- Charts section -->
<% if (registro) { %>
  <div class="grid grid-2 gap-4">
    <!-- EA por tipo (bar chart via CSS) -->
    <div class="glass-card no-hover" style="padding:1.25rem">
      <h4 style="font-size:.875rem;font-weight:600;color:var(--color-text-primary);margin-bottom:1rem">Eventos Adversos por Tipo</h4>
      <% const eaData = [
        { nome: 'Quedas', valor: Number(registro.ea_quedas ?? 0), cor: '#fbbf24' },
        { nome: 'Broncoasp.', valor: Number(registro.ea_broncoaspiracao ?? 0), cor: '#f87171' },
        { nome: 'Lesão Press.', valor: Number(registro.ea_lesao_pressao ?? 0), cor: '#a78bfa' },
        { nome: 'Decanulação', valor: Number(registro.ea_decanulacao ?? 0), cor: '#60a5fa' },
        { nome: 'Saída GTT', valor: Number(registro.ea_saida_gtt ?? 0), cor: '#34d399' },
      ];
      const maxEA = Math.max(1, ...eaData.map(d => d.valor)); %>
      <div class="space-y-2">
        <% eaData.forEach(function(d) { %>
          <div class="flex items-center gap-2">
            <span style="width:80px;font-size:.75rem;color:var(--color-text-muted);text-align:right"><%= d.nome %></span>
            <div style="flex:1;height:1.5rem;background:var(--overlay-soft);border-radius:var(--radius-sm);overflow:hidden">
              <div style="height:100%;width:<%= (d.valor / maxEA * 100) %>%;background:<%= d.cor %>;border-radius:var(--radius-sm);transition:width .6s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:.375rem">
                <% if (d.valor > 0) { %><span style="font-size:.625rem;font-weight:700;color:white"><%= d.valor %></span><% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Modalidade (donut via CSS) -->
    <div class="glass-card no-hover" style="padding:1.25rem">
      <h4 style="font-size:.875rem;font-weight:600;color:var(--color-text-primary);margin-bottom:1rem">Pacientes por Modalidade</h4>
      <div class="flex items-center" style="justify-content:center;gap:2rem">
        <% const totalMod = pacientesAD + pacientesID || 1; const adPct = (pacientesAD / totalMod * 100).toFixed(0); %>
        <div style="width:120px;height:120px;border-radius:50%;background:conic-gradient(#60a5fa 0% <%= adPct %>%, #a78bfa <%= adPct %>% 100%);display:flex;align-items:center;justify-content:center">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--color-surface-1);display:flex;align-items:center;justify-content:center;flex-direction:column">
            <span style="font-size:1.125rem;font-weight:700;color:var(--color-text-primary)"><%= pacientesTotal %></span>
            <span style="font-size:.5625rem;color:var(--color-text-muted)">total</span>
          </div>
        </div>
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <div style="width:12px;height:12px;border-radius:50%;background:#60a5fa"></div>
            <span style="font-size:.75rem;color:var(--color-text-secondary)">AD: <%= pacientesAD %></span>
          </div>
          <div class="flex items-center gap-2">
            <div style="width:12px;height:12px;border-radius:50%;background:#a78bfa"></div>
            <span style="font-size:.75rem;color:var(--color-text-secondary)">ID: <%= pacientesID %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 2: More charts -->
  <div class="grid grid-3 gap-4">
    <% const miniCharts = [
      { titulo: 'Ouvidorias', items: [{ nome: 'Elogios', valor: Number(registro.ouv_elogios??0), cor: '#34d399' }, { nome: 'Sugestões', valor: Number(registro.ouv_sugestoes??0), cor: '#fbbf24' }, { nome: 'Reclamações', valor: Number(registro.ouv_reclamacoes??0), cor: '#f87171' }] },
      { titulo: 'Óbitos', items: [{ nome: '<48h', valor: Number(registro.obitos_menos_48h??0), cor: '#fbbf24' }, { nome: '≥48h', valor: Number(registro.obitos_mais_48h??0), cor: '#f87171' }] },
      { titulo: 'Internação', items: [{ nome: 'Deterioração', valor: Number(registro.intern_deterioracao??0), cor: '#f87171' }, { nome: 'Não Aderência', valor: Number(registro.intern_nao_aderencia??0), cor: '#fbbf24' }] },
    ]; %>
    <% miniCharts.forEach(function(chart) { %>
      <% const total = chart.items.reduce((s,i) => s + i.valor, 0) || 1; %>
      <div class="glass-card no-hover" style="padding:1.25rem">
        <h4 style="font-size:.875rem;font-weight:600;color:var(--color-text-primary);margin-bottom:1rem"><%= chart.titulo %></h4>
        <div class="flex items-center" style="justify-content:center;gap:1.5rem">
          <% let accumulated = 0; %>
          <div style="width:90px;height:90px;border-radius:50%;background:conic-gradient(<% chart.items.forEach(function(item, idx) { const pct = item.valor / total * 100; %><%= item.cor %> <%= accumulated %>% <%= accumulated + pct %>%<%= idx < chart.items.length - 1 ? ',' : '' %><% accumulated += pct; }) %>);display:flex;align-items:center;justify-content:center">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--color-surface-1);display:flex;align-items:center;justify-content:center">
              <span style="font-size:.875rem;font-weight:700;color:var(--color-text-primary)"><%= chart.items.reduce((s,i) => s + i.valor, 0) %></span>
            </div>
          </div>
          <div class="space-y-1">
            <% chart.items.forEach(function(item) { %>
              <div class="flex items-center gap-2">
                <div style="width:8px;height:8px;border-radius:50%;background:<%= item.cor %>"></div>
                <span style="font-size:.6875rem;color:var(--color-text-muted)"><%= item.nome %>: <strong><%= item.valor %></strong></span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<script>
function updateDashboard() {
  const m = document.getElementById('dash-mes').value;
  const a = document.getElementById('dash-ano').value;
  window.location.href = '/dashboard?ano=' + a + '&mes=' + m;
}
</script>
