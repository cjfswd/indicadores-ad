<%
const MESES_CURTOS = ['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
const INDICADOR_LABELS = {
  '01': 'Taxa de Altas (%)', '02': 'Intercorrências', '03': 'Taxa Internação (%)', '04': 'Óbitos',
  '05': 'Alteração PAD (%)', '06': 'Censo AD/ID', '07': 'Infectados', '08': 'Eventos Adversos', '09': 'Reclamações',
};
const isEdit = typeof meta !== 'undefined' && meta;
%>
<div class="modal-backdrop" onclick="if(event.target===this)closeModal()">
  <div class="modal-content">
    <div class="modal-header">
      <h3><%= isEdit ? 'Editar Meta' : 'Definir Meta' %></h3>
      <button class="btn btn-ghost btn-icon" onclick="closeModal()">&times;</button>
    </div>
    <form hx-put="/metas" hx-target="#metas-content" hx-swap="innerHTML" hx-encoding="multipart/form-data">
      <input type="hidden" name="ano" value="<%= ano %>">
      <div class="space-y-4" style="margin-bottom:1rem">
        <div class="form-group">
          <label class="form-label">Indicador</label>
          <select name="indicador_codigo" class="form-select" required>
            <% Object.entries(INDICADOR_LABELS).forEach(function([codigo, nome]) { %>
              <option value="<%= codigo %>" <%= isEdit && meta.indicador_codigo === codigo ? 'selected' : '' %>><%= codigo %> — <%= nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="grid grid-2 gap-3">
          <div class="form-group">
            <label class="form-label">Meta</label>
            <input type="number" name="meta_valor" class="form-input" step="0.01" placeholder="Valor da meta"
                   value="<%= isEdit && meta.meta_valor != null ? meta.meta_valor : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Limite de Alerta</label>
            <input type="number" name="limite_alerta" class="form-input" step="0.01" placeholder="Valor de alerta"
                   value="<%= isEdit && meta.limite_alerta != null ? meta.limite_alerta : '' %>">
          </div>
        </div>
        <div class="grid grid-3 gap-3">
          <div class="form-group">
            <label class="form-label">Sentido</label>
            <select name="sentido" class="form-select">
              <option value="menor" <%= isEdit && meta.sentido === 'menor' ? 'selected' : '' %>>↓ Menor melhor</option>
              <option value="maior" <%= isEdit && meta.sentido === 'maior' ? 'selected' : '' %>>↑ Maior melhor</option>
              <option value="neutro" <%= isEdit && meta.sentido === 'neutro' ? 'selected' : '' %>>→ Neutro</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Mês início</label>
            <select name="mes_inicio" class="form-select">
              <% for (let i = 1; i <= 12; i++) { %><option value="<%= i %>" <%= isEdit && meta.mes_inicio === i ? 'selected' : '' %>><%= MESES_CURTOS[i] %></option><% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Mês fim</label>
            <select name="mes_fim" class="form-select">
              <% for (let i = 1; i <= 12; i++) { %><option value="<%= i %>" <%= isEdit && meta.mes_fim === i ? 'selected' : (i === 12 && !isEdit ? 'selected' : '') %>><%= MESES_CURTOS[i] %></option><% } %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Documento de referência <span style="color:var(--color-text-muted);opacity:.6">(opcional)</span></label>
          <input type="file" name="arquivo" class="form-input" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xlsx">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>
