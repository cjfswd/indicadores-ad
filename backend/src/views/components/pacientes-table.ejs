<% if (!pacientes || pacientes.length === 0) { %>
  <div class="empty-state">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    <p>Nenhum paciente encontrado.</p>
  </div>
<% } else { %>
  <div class="glass-card no-hover" style="overflow-x:auto">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Convênio</th>
          <th>Modalidade</th>
          <th>Status</th>
          <th>Criado em</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% pacientes.forEach(function(p) { %>
          <tr id="pac-row-<%= p.id %>">
            <td style="font-weight:600;color:var(--color-text-primary)"><%= p.nome %></td>
            <td><span class="badge badge-neutro"><%= p.convenio %></span></td>
            <td><span class="badge badge-muted"><%= p.modalidade %></span></td>
            <td>
              <span class="badge <%= p.status === 'ativo' ? 'badge-verde' : p.status === 'inativo' ? 'badge-amarelo' : 'badge-vermelho' %>">
                <%= p.status.charAt(0).toUpperCase() + p.status.slice(1) %>
              </span>
            </td>
            <td class="text-xs text-muted"><%= new Date(p.criado_em).toLocaleDateString('pt-BR') %></td>
            <td>
              <div class="flex gap-2">
                <% if (p.status === 'ativo') { %>
                  <button class="btn btn-ghost btn-sm"
                          hx-put="/pacientes/<%= p.id %>/desativar"
                          hx-target="#pacientes-table-container"
                          hx-confirm="Desativar paciente <%= p.nome %>?">
                    Desativar
                  </button>
                <% } else if (p.status === 'inativo') { %>
                  <button class="btn btn-ghost btn-sm"
                          hx-put="/pacientes/<%= p.id %>/reativar"
                          hx-target="#pacientes-table-container">
                    Reativar
                  </button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
