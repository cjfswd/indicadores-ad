<%
const INDICADOR_LABELS = {
  '01': 'Taxa de Altas (%)',
  '02': 'Intercorrências',
  '03': 'Taxa Internação (%)',
  '04': 'Óbitos',
  '05': 'Alteração PAD (%)',
  '06': 'Censo AD/ID',
  '07': 'Infectados',
  '08': 'Eventos Adversos',
  '09': 'Reclamações',
};
const MESES_CURTOS = ['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
const SENTIDO_CONFIG = {
  maior: { label: '↑ Maior melhor', color: '#34d399', bg: 'rgba(16,185,129,.12)' },
  menor: { label: '↓ Menor melhor', color: '#f87171', bg: 'rgba(239,68,68,.12)' },
  neutro: { label: '→ Neutro', color: '#60a5fa', bg: 'rgba(59,130,246,.12)' },
};
const INDICADOR_ICONS = {
  '01': { color: '#34d399', bg: 'rgba(16,185,129,.15)' },
  '02': { color: '#fbbf24', bg: 'rgba(245,158,11,.15)' },
  '03': { color: '#f87171', bg: 'rgba(239,68,68,.15)' },
  '04': { color: '#ef4444', bg: 'rgba(239,68,68,.15)' },
  '05': { color: '#60a5fa', bg: 'rgba(59,130,246,.15)' },
  '06': { color: '#a78bfa', bg: 'rgba(139,92,246,.15)' },
  '07': { color: '#f97316', bg: 'rgba(249,115,22,.15)' },
  '08': { color: '#ec4899', bg: 'rgba(236,72,153,.15)' },
  '09': { color: '#22d3ee', bg: 'rgba(6,182,212,.15)' },
};
%>

<% if (metas.length === 0) { %>
  <div style="text-align:center;padding:4rem 0;color:var(--color-text-muted)">
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto .75rem;opacity:.3"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
    <p style="font-size:.875rem">Nenhuma meta definida para <%= ano %></p>
  </div>
<% } else { %>
  <div class="space-y-3">
    <% metas.forEach(function(m, i) { %>
      <% const sentido = SENTIDO_CONFIG[m.sentido] || SENTIDO_CONFIG.neutro; %>
      <% const icon = INDICADOR_ICONS[m.indicador_codigo] || { color: '#94a3b8', bg: 'rgba(148,163,184,.15)' }; %>
      <div class="meta-card" style="animation:fadeIn .3s ease <%= i * 40 %>ms both">
        <!-- Indicator name + code -->
        <div class="meta-indicator">
          <div style="width:2.25rem;height:2.25rem;border-radius:var(--radius-md);background:<%= icon.bg %>;color:<%= icon.color %>;display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <span style="font-size:.75rem;font-weight:700;font-family:monospace"><%= m.indicador_codigo %></span>
          </div>
          <div style="min-width:0">
            <p style="font-size:.875rem;font-weight:600;color:var(--color-text-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= INDICADOR_LABELS[m.indicador_codigo] || m.indicador_codigo %></p>
            <p style="font-size:.6875rem;color:var(--color-text-muted)"><%= MESES_CURTOS[m.mes_inicio || 1] %> – <%= MESES_CURTOS[m.mes_fim || 12] %> / <%= ano %></p>
          </div>
        </div>

        <!-- Meta value -->
        <div class="meta-stat">
          <div class="meta-stat-label">Meta</div>
          <div class="meta-stat-value" style="color:<%= m.meta_valor != null ? 'var(--color-text-primary)' : 'var(--color-surface-3)' %>">
            <%= m.meta_valor != null ? m.meta_valor : '—' %>
          </div>
        </div>

        <!-- Alert value -->
        <div class="meta-stat">
          <div class="meta-stat-label">Alerta</div>
          <div class="meta-stat-value" style="color:<%= m.limite_alerta != null ? '#fbbf24' : 'var(--color-surface-3)' %>">
            <%= m.limite_alerta != null ? m.limite_alerta : '—' %>
          </div>
        </div>

        <!-- Sentido badge -->
        <div style="min-width:100px;text-align:center">
          <span style="display:inline-flex;align-items:center;gap:.25rem;padding:.25rem .625rem;border-radius:9999px;font-size:.6875rem;font-weight:600;background:<%= sentido.bg %>;color:<%= sentido.color %>">
            <%= sentido.label %>
          </span>
        </div>

        <!-- Edit button -->
        <button class="btn-icon" title="Editar" onclick='openMetaModal(<%- JSON.stringify({id:m.id,indicador_codigo:m.indicador_codigo,ano:m.ano,meta_valor:m.meta_valor,limite_alerta:m.limite_alerta,sentido:m.sentido,mes_inicio:m.mes_inicio,mes_fim:m.mes_fim}) %>)'>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
        </button>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- Modal: Criar/Editar Meta -->
<div class="modal-backdrop" id="modal-meta" style="display:none" onclick="if(event.target===this)this.style.display='none'">
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="meta-modal-title">Definir Meta</h3>
      <button class="btn btn-ghost btn-icon" onclick="this.closest('.modal-backdrop').style.display='none'">&times;</button>
    </div>
    <form id="form-meta" hx-put="/metas" hx-target="#metas-content" hx-swap="innerHTML"
          hx-on::after-request="if(event.detail.successful){document.getElementById('modal-meta').style.display='none';showToast('Meta salva!')}">
      <input type="hidden" name="ano" value="<%= ano %>">
      <div class="space-y-4" style="margin-bottom:1rem">
        <div class="form-group">
          <label class="form-label">Indicador</label>
          <select name="indicador_codigo" id="meta-indicador" class="form-select" required>
            <% Object.entries(INDICADOR_LABELS).forEach(function([codigo, nome]) { %>
              <option value="<%= codigo %>"><%= codigo %> — <%= nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="grid grid-2 gap-3">
          <div class="form-group">
            <label class="form-label">Meta</label>
            <input type="number" name="meta_valor" id="meta-valor" class="form-input" step="0.01" placeholder="Valor da meta">
          </div>
          <div class="form-group">
            <label class="form-label">Limite de Alerta</label>
            <input type="number" name="limite_alerta" id="meta-alerta" class="form-input" step="0.01" placeholder="Valor de alerta">
          </div>
        </div>
        <div class="grid grid-3 gap-3">
          <div class="form-group">
            <label class="form-label">Sentido</label>
            <select name="sentido" id="meta-sentido" class="form-select">
              <option value="menor">↓ Menor melhor</option>
              <option value="maior">↑ Maior melhor</option>
              <option value="neutro">→ Neutro</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Mês início</label>
            <select name="mes_inicio" id="meta-inicio" class="form-select">
              <% for (let i = 1; i <= 12; i++) { %><option value="<%= i %>"><%= MESES_CURTOS[i] %></option><% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Mês fim</label>
            <select name="mes_fim" id="meta-fim" class="form-select">
              <% for (let i = 1; i <= 12; i++) { %><option value="<%= i %>" <%= i === 12 ? 'selected' : '' %>><%= MESES_CURTOS[i] %></option><% } %>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="this.closest('.modal-backdrop').style.display='none'">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<script>
function openMetaModal(m) {
  if (m) {
    document.getElementById('meta-modal-title').textContent = 'Editar Meta';
    document.getElementById('meta-indicador').value = m.indicador_codigo;
    document.getElementById('meta-valor').value = m.meta_valor ?? '';
    document.getElementById('meta-alerta').value = m.limite_alerta ?? '';
    document.getElementById('meta-sentido').value = m.sentido || 'menor';
    document.getElementById('meta-inicio').value = m.mes_inicio || 1;
    document.getElementById('meta-fim').value = m.mes_fim || 12;
  } else {
    document.getElementById('meta-modal-title').textContent = 'Definir Meta';
    document.getElementById('form-meta').reset();
  }
  document.getElementById('modal-meta').style.display = 'flex';
}
</script>
