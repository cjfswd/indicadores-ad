<div class="glass-card no-hover" style="overflow-x:auto">
  <table class="data-table">
    <thead>
      <tr>
        <th>Indicador</th>
        <th>Nome</th>
        <th>Sentido</th>
        <th>Meta</th>
        <th>Limite Alerta</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% const codes = ['01','02','03','04','05','06','07','08','09']; %>
      <% codes.forEach(function(cod) { %>
        <% const meta = metas.find(function(m) { return m.indicador_codigo === cod }); %>
        <% const config = indicadores[cod]; %>
        <tr>
          <td style="font-weight:600;color:var(--color-text-primary);font-family:monospace"><%= cod %></td>
          <td><%= config ? config.nome : cod %></td>
          <td>
            <span class="badge badge-muted">
              <%= config ? (config.sentido === 'maior' ? '↑ Maior' : config.sentido === 'menor' ? '↓ Menor' : '● Neutro') : '?' %>
            </span>
          </td>
          <td id="meta-val-<%= cod %>">
            <% if (meta) { %>
              <%= meta.meta_valor != null ? meta.meta_valor : '—' %>
            <% } else { %>
              —
            <% } %>
          </td>
          <td id="meta-alert-<%= cod %>">
            <% if (meta) { %>
              <%= meta.limite_alerta != null ? meta.limite_alerta : '—' %>
            <% } else { %>
              —
            <% } %>
          </td>
          <td>
            <button class="btn btn-ghost btn-sm"
                    onclick="openMetaEdit('<%= cod %>', '<%= meta ? (meta.meta_valor ?? '') : '' %>', '<%= meta ? (meta.limite_alerta ?? '') : '' %>', '<%= meta ? meta.id : '' %>')">
              Editar
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Inline edit modal -->
<div class="modal-backdrop" id="modal-meta-edit" style="display:none" onclick="if(event.target===this)this.style.display='none'">
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="meta-edit-title">Editar Meta</h3>
      <button class="btn btn-ghost btn-icon" onclick="this.closest('.modal-backdrop').style.display='none'">&times;</button>
    </div>
    <form id="meta-edit-form" hx-target="#metas-table-container" hx-swap="innerHTML"
          hx-on::after-request="if(event.detail.successful){document.getElementById('modal-meta-edit').style.display='none';showToast('Meta atualizada!')}">
      <div class="grid grid-2 gap-3 mb-4">
        <div class="form-group">
          <label class="form-label">Meta Valor</label>
          <input type="number" step="0.1" name="meta_valor" id="meta-edit-valor" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Limite Alerta</label>
          <input type="number" step="0.1" name="limite_alerta" id="meta-edit-alerta" class="form-input">
        </div>
      </div>
      <input type="hidden" name="indicador_codigo" id="meta-edit-codigo">
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="this.closest('.modal-backdrop').style.display='none'">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<script>
function openMetaEdit(codigo, metaValor, limiteAlerta, metaId) {
  document.getElementById('meta-edit-title').textContent = 'Editar Meta — Indicador ' + codigo;
  document.getElementById('meta-edit-valor').value = metaValor;
  document.getElementById('meta-edit-alerta').value = limiteAlerta;
  document.getElementById('meta-edit-codigo').value = codigo;
  const form = document.getElementById('meta-edit-form');
  if (metaId) {
    form.setAttribute('hx-put', '/metas/' + metaId);
  } else {
    form.setAttribute('hx-post', '/metas');
  }
  htmx.process(form);
  document.getElementById('modal-meta-edit').style.display = 'flex';
}
</script>
