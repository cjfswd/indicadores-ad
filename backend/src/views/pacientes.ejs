<div class="page-header">
  <div>
    <h2>Pacientes</h2>
    <p>Gestão do cadastro de pacientes AD/ID</p>
  </div>
  <div class="flex items-center gap-3">
    <div class="filter-tabs" id="pacientes-status-filter">
      <button class="filter-tab active" hx-get="/pacientes/table?status=ativo" hx-target="#pacientes-table-container"
              onclick="document.querySelectorAll('#pacientes-status-filter .filter-tab').forEach(b=>b.classList.remove('active'));this.classList.add('active')">Ativos</button>
      <button class="filter-tab" hx-get="/pacientes/table?status=inativo" hx-target="#pacientes-table-container"
              onclick="document.querySelectorAll('#pacientes-status-filter .filter-tab').forEach(b=>b.classList.remove('active'));this.classList.add('active')">Inativos</button>
      <button class="filter-tab" hx-get="/pacientes/table?status=todos" hx-target="#pacientes-table-container"
              onclick="document.querySelectorAll('#pacientes-status-filter .filter-tab').forEach(b=>b.classList.remove('active'));this.classList.add('active')">Todos</button>
    </div>
    <button class="btn btn-primary" onclick="document.getElementById('modal-paciente').style.display='flex'">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo Paciente
    </button>
    <span class="htmx-indicator"><span class="spinner"></span></span>
  </div>
</div>

<div id="pacientes-table-container">
  <%- include('./components/pacientes-table', { pacientes }) %>
</div>

<!-- Modal: Novo Paciente -->
<div class="modal-backdrop" id="modal-paciente" style="display:none" onclick="if(event.target===this)this.style.display='none'">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Novo Paciente</h3>
      <button class="btn btn-ghost btn-icon" onclick="this.closest('.modal-backdrop').style.display='none'">&times;</button>
    </div>
    <form hx-post="/pacientes" hx-target="#pacientes-table-container" hx-swap="innerHTML"
          hx-on::after-request="if(event.detail.successful){this.closest('.modal-backdrop').style.display='none';this.reset();showToast('Paciente cadastrado!')}">
      <div class="grid grid-2 gap-3 mb-4">
        <div class="form-group" style="grid-column:span 2">
          <label class="form-label">Nome Completo</label>
          <input type="text" name="nome" class="form-input" required minlength="3" maxlength="200" placeholder="Nome do paciente">
        </div>
        <div class="form-group">
          <label class="form-label">Data de Nascimento</label>
          <input type="date" name="data_nascimento" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Convênio</label>
          <select name="convenio" class="form-select" required>
            <option value="Camperj">Camperj</option>
            <option value="Unimed">Unimed</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Modalidade</label>
          <select name="modalidade" class="form-select" required>
            <option value="AD">AD</option>
            <option value="ID">ID</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Observações</label>
          <textarea name="observacoes" class="form-textarea" placeholder="Observações opcionais" maxlength="2000"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="this.closest('.modal-backdrop').style.display='none'">Cancelar</button>
        <button type="submit" class="btn btn-primary">Cadastrar</button>
      </div>
    </form>
  </div>
</div>
