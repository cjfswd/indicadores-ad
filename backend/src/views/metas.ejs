<div class="page-header">
  <div>
    <h2>Metas</h2>
    <p>Metas e limites de alerta por indicador</p>
  </div>
  <div class="flex items-center gap-3">
    <select class="form-select" style="width:auto"
            hx-get="/metas/table"
            hx-target="#metas-table-container"
            name="ano">
      <% for (let y = new Date().getFullYear(); y >= 2024; y--) { %>
        <option value="<%= y %>" <%= y === ano ? 'selected' : '' %>><%= y %></option>
      <% } %>
    </select>
    <span class="htmx-indicator"><span class="spinner"></span></span>
  </div>
</div>

<div id="metas-table-container">
  <%- include('./components/metas-table', { metas, indicadores: indicadoresConfig }) %>
</div>
