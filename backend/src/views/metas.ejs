<div class="page-header">
  <div class="flex items-center gap-3">
    <div style="width:2.5rem;height:2.5rem;border-radius:var(--radius-md);background:rgba(245,158,11,.15);color:#fbbf24;display:flex;align-items:center;justify-content:center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
    </div>
    <div>
      <h2>Metas</h2>
      <p>Configuração de metas e limites de alerta por indicador</p>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <select class="form-select" style="width:auto" name="metasAno"
            hx-get="/metas/content" hx-target="#metas-content" hx-swap="innerHTML">
      <option value="2025">2025</option>
      <option value="2026" selected>2026</option>
      <option value="2027">2027</option>
    </select>
    <button class="btn btn-primary"
            hx-get="/metas/modal/editar" hx-target="#modal-container" hx-swap="innerHTML"
            hx-include="[name='metasAno']">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Definir Meta
    </button>
  </div>
</div>

<div id="metas-content"
     hx-get="/metas/content"
     hx-trigger="load"
     hx-include="[name='metasAno']"
     hx-swap="innerHTML">
</div>
